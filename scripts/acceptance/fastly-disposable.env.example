# Copy into a CI secret/configuration store; do not commit real credentials.
# Use a disposable subdomain under a zone you control. The current Fastly
# versionless-domain path requires managed TLS before it serves traffic.
# Leave MAGELIFT_FASTLY_TOKEN_NAME unset to use the Fastly CLI login session.
# Set it only to select a stored named token; `default` is not the login session.
MAGELIFT_FASTLY_ACCEPTANCE=1
MAGELIFT_FASTLY_ACCEPTANCE_DOMAIN=disposable.example.com
# Exact non-TLS target from Fastly's current domain/DNS instructions, or the
# assigned TLS CNAME returned by the Fastly TLS subscription for a TLS run.
MAGELIFT_FASTLY_ACCEPTANCE_CNAME_TARGET=x.sni.global.fastly.net
MAGELIFT_FASTLY_ACCEPTANCE_ORIGIN_ADDRESS=origin.example.com
MAGELIFT_FASTLY_ACCEPTANCE_ORIGIN_HOST=origin.example.com
MAGELIFT_FASTLY_ACCEPTANCE_ORIGIN_URL=https://origin.example.com/healthz
MAGELIFT_FASTLY_ACCEPTANCE_ROUTE_PATH=/healthz
MAGELIFT_FASTLY_ACCEPTANCE_ORIGIN_USE_TLS=1
MAGELIFT_FASTLY_ACCEPTANCE_TLS=1
MAGELIFT_FASTLY_ACCEPTANCE_EXPECTED_STATUS=200
MAGELIFT_FASTLY_ACCEPTANCE_ROUTE_TIMEOUT_SECONDS=300
# Optional deterministic suffix for reruns; the wrapper always namespaces it.
MAGELIFT_FASTLY_ACCEPTANCE_RUN_ID=ci-run
