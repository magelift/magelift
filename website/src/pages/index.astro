---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Personas from "../components/Personas.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Targets from "../components/Targets.astro";
import Trust from "../components/Trust.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import { faqs } from "../data/content.js";

const title = "MageLift | Deploy Magento 2 to your own cloud";
const description =
  "Run Magento 2 locally and deploy to your own AWS, Google Cloud, or Azure account. Keep project settings in PHP.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://magelift.dev/#org",
      name: "MageLift",
      url: "https://magelift.dev/",
      logo: "https://magelift.dev/media/logo.png",
      sameAs: ["https://github.com/magelift/magelift"],
      description:
        "Open-source Magento deployment CLI for AWS, Google Cloud and Azure.",
    },
    {
      "@type": "WebSite",
      "@id": "https://magelift.dev/#website",
      url: "https://magelift.dev/",
      name: "MageLift",
      description:
        "Deploy Magento in your AWS, Google Cloud or Azure account with a PHP project file.",
      publisher: { "@id": "https://magelift.dev/#org" },
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://magelift.dev/#app",
      name: "MageLift",
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "Magento deployment CLI",
      operatingSystem: "Linux, macOS, Windows",
      url: "https://magelift.dev/",
      downloadUrl: "https://github.com/magelift/magelift/releases",
      installUrl: "https://magelift.dev/docs/install/",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        description: "The CLI is free. Your cloud provider bills your account.",
      },
      featureList: [
        "Project configuration in PHP",
        "AWS ECS Fargate",
        "GCP GKE Autopilot",
        "Experimental Azure AKS",
        "Staging, UAT, production and pull-request previews",
        "Local Magento with Docker Compose",
        "PaaS config import from ACC and Upsun",
      ],
      description:
        "Open-source CLI and PHP configuration to run Magento Open Source and Adobe Commerce in your AWS, Google Cloud or Azure account.",
      isAccessibleForFree: true,
      creator: { "@id": "https://magelift.dev/#org" },
    },
    {
      "@type": "HowTo",
      name: "Deploy Magento with MageLift in your cloud account",
      description:
        "Start from your Magento checkout and run the shop locally before deploying.",
      step: [
        {
          "@type": "HowToStep",
          name: "Install the CLI",
          text: "From a MageLift checkout, run go install ./cmd/magelift.",
          url: "https://magelift.dev/docs/install/",
        },
        {
          "@type": "HowToStep",
          name: "Run locally",
          text: "Run magelift init in the Magento checkout, then start the shop with magelift dev.",
          url: "https://magelift.dev/docs/getting-started/",
        },
        {
          "@type": "HowToStep",
          name: "Deploy to staging",
          text: "Connect your cloud account, build a shop image, and review the plan before deploying to staging.",
          url: "https://magelift.dev/docs/getting-started/",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://magelift.dev/#faq",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---
<Base title={title} description={description} schema={schema}>
  <Nav />
  <Hero />
  <main class="wrap">
    <ProofStrip />
    <Personas />
    <HowItWorks />
    <Targets />
    <Trust />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <script src="../scripts/landing.js"></script>
</Base>
