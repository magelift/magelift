---
import { hero } from "../data/content.js";
import Terminal from "./Terminal.astro";
---
<div class="hero-plane">
  <picture class="hero-media" aria-hidden="true">
    <source
      type="image/avif"
      srcset="/media/hero-atmosphere-1600.avif 1600w, /media/hero-atmosphere-2560.avif 2560w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/media/hero-atmosphere-1600.webp 1600w, /media/hero-atmosphere-2560.webp 2560w"
      sizes="100vw"
    />
    <img
      src="/media/hero-atmosphere-1600.jpg"
      srcset="/media/hero-atmosphere-1600.jpg 1600w, /media/hero-atmosphere-2560.jpg 2560w"
      sizes="100vw"
      width="1600"
      height="1067"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-grid-overlay" aria-hidden="true"></div>

  <div class="wrap hero">
    <div class="hero-copy">
      <p class="brand-mark" data-enter>
        <img src="/media/logo.png" width="56" height="56" alt="" />
        <span>MageLift</span>
      </p>
      <h1 data-enter>{hero.h1}</h1>
      <p class="lede" data-enter>{hero.lede}</p>
      <div class="cta-row" data-enter>
        <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn-ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>
    <Terminal />
  </div>
</div>

<style>
  .hero-plane {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  .hero-plane::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      105deg,
      rgba(238, 242, 246, 0.98) 0%,
      rgba(238, 242, 246, 0.94) 38%,
      rgba(238, 242, 246, 0.78) 58%,
      rgba(226, 232, 240, 0.45) 100%
    );
  }
  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(11, 18, 32, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 18, 32, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 78%);
    pointer-events: none;
  }
  .hero {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 2.25rem;
    align-items: center;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: 3rem;
  }
  .hero-copy {
    max-width: 36rem;
  }
  .brand-mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 5.5vw, 3.7rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    margin: 0 0 0.85rem;
    color: var(--ink);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.55);
  }
  .brand-mark img {
    width: clamp(2.5rem, 5vw, 3.5rem);
    height: clamp(2.5rem, 5vw, 3.5rem);
    border-radius: 0.85rem;
    flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(11, 18, 32, 0.12);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.45rem, 2.7vw, 1.95rem);
    line-height: 1.2;
    margin: 0 0 0.85rem;
    letter-spacing: -0.025em;
    max-width: 24ch;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    font-size: 1.08rem;
    color: #334155;
    max-width: 34rem;
    text-wrap: pretty;
  }

  /* Progressive enhancement: subtle grid drift tied to page scroll.
     Chrome/Edge 115+, Safari 26+, Firefox 156+. Others keep a static hero. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-grid-overlay {
        animation: grid-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100dvh;
      }
      @keyframes grid-drift {
        from {
          transform: translateY(0);
        }
        to {
          transform: translateY(56px);
        }
      }
    }
  }

  @media (max-width: 900px) {
    .hero-plane {
      min-height: auto;
    }
    .hero-media img {
      object-position: center top;
    }
    .hero-plane::before {
      background: linear-gradient(
        180deg,
        rgba(238, 242, 246, 0.94) 0%,
        rgba(238, 242, 246, 0.88) 55%,
        rgba(226, 232, 240, 0.75) 100%
      );
    }
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: calc(var(--header-h) + 1rem);
      align-items: start;
    }
  }
</style>
