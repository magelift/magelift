---
import { trust } from "../data/content.js";
---
<section class="section" data-reveal>
  <h2>{trust.heading}</h2>
  <p class="lede">{trust.lede}</p>

  <div class="trust-grid">
    {trust.items.map((item) => (
      <article>
        <h3>{item.h}</h3>
        <p>{item.p}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .trust-grid article {
    padding: 1.15rem 1.1rem 1.15rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .trust-grid article + article {
    padding-left: 1.1rem;
    border-left: 1px solid var(--rule);
  }
  .trust-grid h3 {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }
  .trust-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .trust-grid {
      grid-template-columns: 1fr 1fr;
    }
    .trust-grid article:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 560px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
    .trust-grid article + article {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
