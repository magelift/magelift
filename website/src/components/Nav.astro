---
import { nav } from "../data/content.js";

const textLinks = nav.links.filter((link) => link.label !== "GitHub");
const github = nav.links.find((link) => link.label === "GitHub");
---
<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a class="brand-nav" href="/" aria-label="MageLift home">
      <img src="/media/logo.png" width="32" height="32" alt="" />
      MageLift
    </a>
    <nav aria-label="Primary">
      {textLinks.map((link) => (
        <a class="nav-hide-sm" href={link.href}>{link.label}</a>
      ))}
      {github && (
        <a class="gh-link" href={github.href} aria-label="MageLift on GitHub">
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span class="nav-hide-sm">GitHub</span>
        </a>
      )}
      <a class="nav-cta" href={nav.cta.href}>{nav.cta.label}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    border-bottom: 1px solid transparent;
    transition:
      background 220ms ease,
      border-color 220ms ease,
      backdrop-filter 220ms ease;
  }
  .site-header.is-scrolled {
    background: color-mix(in oklch, var(--bg0) 82%, transparent);
    border-bottom-color: var(--rule);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    padding: 0.55rem 0;
  }
  .brand-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-nav img {
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    flex-shrink: 0;
  }
  nav {
    display: flex;
    gap: 1.15rem;
    font-size: 0.95rem;
    flex-wrap: nowrap;
    align-items: center;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 160ms ease;
  }
  nav a:hover {
    color: var(--ink);
  }
  .gh-link {
    gap: 0.4rem;
  }
  .gh-link svg {
    display: block;
  }
  .nav-cta {
    background: var(--accent);
    color: var(--accent-ink) !important;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius);
    font-weight: 600;
    transition:
      background 160ms ease,
      transform 160ms ease;
  }
  .nav-cta:hover {
    background: var(--accent-strong);
    transform: translateY(-1px);
  }
  .nav-cta:active {
    transform: scale(0.98);
  }
  @media (max-width: 900px) {
    .nav-hide-sm {
      display: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header.is-scrolled {
      background: var(--bg0);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
