{
	storage file_system /tmp/magelift-caddy
	skip_install_trust
}

:8080 {
	# ALB/ECS liveness: no Magento bootstrap (static OK).
	handle /health {
		header Content-Type text/plain
		respond "OK\n" 200
	}
	root * /app/pub
	encode gzip
	php_server
	log {
		output stdout
		format json
	}
}

https://localhost:8443 {
	tls internal
	handle /health {
		header Content-Type text/plain
		respond "OK\n" 200
	}
	root * /app/pub
	encode gzip
	php_server
	log {
		output stdout
		format json
	}
}
