---
const docsUrl = '/docs/';
const githubUrl = 'https://github.com/magelift/magelift';
const faqs = [
  {
    q: 'What is MageLift?',
    a: 'MageLift is an open-source CLI plus ACC/Upsun-shaped YAML for Magento Open Source and Adobe Commerce in your AWS or GCP account. You run it against your own cloud; MageLift does not host stores.',
  },
  {
    q: 'Is MageLift a Magento hosting provider?',
    a: 'MageLift does not host Magento. It is Apache-2.0 software you run in your account. ACC and Upsun rent you a platform; MageLift targets infrastructure you already control.',
  },
  {
    q: 'How much does MageLift cost?',
    a: 'The CLI is free under Apache-2.0. AWS or GCP bills you for compute, data, and network. Run magelift cost for AWS shape estimates, and destroy preview stacks when you are done.',
  },
  {
    q: 'Which clouds are certified for production?',
    a: 'AWS ECS Fargate and GCP GKE Autopilot. AWS EKS, OVH MKS, and Scaleway Kapsule are experimental and not production-supported yet.',
  },
  {
    q: 'Can I migrate from Adobe Commerce Cloud or Upsun?',
    a: 'Config import is magelift init --from-acc or --from-upsun. Dump, media, and DNS cutover steps are in the migration guides.',
  },
  {
    q: 'Is MageLift affiliated with Adobe?',
    a: 'MageLift is independent of Adobe Inc. Magento and Adobe Commerce are Adobe trademarks; we use the names only to describe compatibility.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://magelift.dev/#org',
      name: 'MageLift',
      url: 'https://magelift.dev/',
      logo: 'https://magelift.dev/media/logo.png',
      sameAs: ['https://github.com/magelift/magelift'],
      description:
        'Open-source Magento deployment CLI for AWS and GCP. Not a hosting provider.',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://magelift.dev/#website',
      url: 'https://magelift.dev/',
      name: 'MageLift',
      description:
        'Deploy Magento in your own AWS or GCP account with ACC/Upsun-shaped YAML.',
      publisher: { '@id': 'https://magelift.dev/#org' },
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://magelift.dev/#app',
      name: 'MageLift',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Magento deployment CLI',
      operatingSystem: 'Linux, macOS, Windows',
      url: 'https://magelift.dev/',
      downloadUrl: 'https://github.com/magelift/magelift/releases',
      installUrl: 'https://magelift.dev/docs/install/',
      softwareVersion: 'main (first public tag target v1.0.0-rc.1)',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        description: 'Open-source CLI is free; you pay your AWS or GCP bill.',
      },
      featureList: [
        'ACC/Upsun-shaped magelift.yaml',
        'Certified AWS ECS Fargate',
        'Certified GCP GKE Autopilot',
        'Preview, deploy, destroy day-2 CLI',
        'Local Compose Magento path',
        'PaaS config import from ACC and Upsun',
      ],
      description:
        'Open-source CLI and YAML to run Magento Open Source and Adobe Commerce in your own AWS or GCP account.',
      isAccessibleForFree: true,
      creator: { '@id': 'https://magelift.dev/#org' },
    },
    {
      '@type': 'HowTo',
      name: 'Deploy Magento with MageLift on a certified cloud target',
      description:
        'Install the MageLift CLI, validate sample YAML, then preview Magento on AWS ECS Fargate or GCP GKE Autopilot.',
      totalTime: 'PT1H',
      step: [
        {
          '@type': 'HowToStep',
          name: 'Install the CLI',
          text: 'Install with go install until the first release tag, then prefer a GitHub Release archive. Run magelift version.',
          url: 'https://magelift.dev/docs/install/',
        },
        {
          '@type': 'HowToStep',
          name: 'Validate sample config',
          text: 'Copy examples/sample-shop/magelift.yaml, fill account and secret refs, then run magelift config validate.',
          url: 'https://magelift.dev/docs/getting-started/',
        },
        {
          '@type': 'HowToStep',
          name: 'Preview and destroy',
          text: 'Bootstrap once, then preview and deploy on a certified target. Destroy when the spike is done.',
          url: 'https://magelift.dev/docs/getting-started/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://magelift.dev/#faq',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MageLift: Magento on AWS and GCP (open-source CLI)</title>
    <meta
      name="description"
      content="Open-source Magento CLI with ACC/Upsun-shaped YAML. Run Magento Open Source and Adobe Commerce in your AWS or GCP account. Certified on ECS Fargate and GKE Autopilot. The software is free; you pay the cloud bill."
    />
    <meta name="author" content="MageLift contributors" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href="https://magelift.dev/" />
    <link rel="alternate" type="text/plain" title="Plain-text site summary" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="Extended plain-text summary" href="/llms-full.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MageLift" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content="https://magelift.dev/" />
    <meta property="og:title" content="MageLift: Magento on AWS and GCP" />
    <meta
      property="og:description"
      content="Open-source CLI and ACC/Upsun-shaped YAML for Magento in your own AWS or GCP account. Certified on ECS Fargate and GKE Autopilot."
    />
    <meta property="og:image" content="https://magelift.dev/media/logo.png" />
    <meta property="og:image:alt" content="MageLift logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="MageLift: Magento on AWS and GCP" />
    <meta
      name="twitter:description"
      content="Open-source Magento CLI for your AWS or GCP account. Free software; you pay the cloud bill."
    />
    <meta name="twitter:image" content="https://magelift.dev/media/logo.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Lexend:wght@500;600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style>
      :root {
        --bg0: #eef2f6;
        --bg1: #e2e8f0;
        --ink: #0b1220;
        --muted: #475569;
        --accent: #0f766e;
        --accent-ink: #f8fafc;
        --rule: rgba(11, 18, 32, 0.12);
        --panel: #ffffff;
        --shadow: 0 18px 40px rgba(11, 18, 32, 0.1);
        --radius: 0.35rem;
        --space-md: 1.5rem;
        --space-lg: 2rem;
        --space-xl: 3rem;
        --space-2xl: 4rem;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: "Source Sans 3", system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg0);
        min-height: 100dvh;
        line-height: 1.55;
        font-size: 1.05rem;
      }
      a {
        color: var(--accent);
        text-underline-offset: 0.15em;
      }
      a:focus-visible,
      .btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      code {
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.92em;
      }
      .wrap {
        width: min(1120px, calc(100% - 2.5rem));
        margin: 0 auto;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 4rem;
        max-height: 5rem;
        padding: 0.85rem 0;
        position: relative;
        z-index: 2;
      }
      .brand-nav {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: Lexend, system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.03em;
        color: var(--ink);
        text-decoration: none;
      }
      .brand-nav img {
        width: 2rem;
        height: 2rem;
        border-radius: 0.45rem;
        flex-shrink: 0;
      }
      nav {
        display: flex;
        gap: 1.15rem;
        font-size: 0.95rem;
        flex-wrap: nowrap;
        align-items: center;
      }
      nav a {
        color: var(--muted);
        text-decoration: none;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      nav a:hover { color: var(--ink); }
      .nav-cta {
        background: var(--accent);
        color: var(--accent-ink) !important;
        padding: 0.45rem 0.85rem;
        border-radius: var(--radius);
        font-weight: 600;
      }
      .nav-cta:hover { filter: brightness(1.05); }

      .hero-plane {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-bottom: 1px solid var(--rule);
        min-height: 100dvh;
        background:
          linear-gradient(
            105deg,
            rgba(238, 242, 246, 0.98) 0%,
            rgba(238, 242, 246, 0.94) 38%,
            rgba(238, 242, 246, 0.78) 58%,
            rgba(226, 232, 240, 0.45) 100%
          ),
          #dce4ea url("/media/hero-atmosphere.png") right center / cover no-repeat;
      }
      .hero-plane::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(11, 18, 32, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(11, 18, 32, 0.035) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 78%);
        pointer-events: none;
        z-index: 0;
      }
      .hero {
        position: relative;
        z-index: 1;
        padding: 2.5rem 0 3.5rem;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 2.25rem;
        align-items: center;
        min-height: calc(100dvh - 5rem);
      }
      .hero-copy {
        max-width: 36rem;
        animation: rise 700ms 40ms ease both;
      }
      .brand-mark {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: Lexend, system-ui, sans-serif;
        font-weight: 700;
        font-size: clamp(2.8rem, 6.5vw, 4.4rem);
        line-height: 1.05;
        letter-spacing: -0.045em;
        margin: 0 0 0.85rem;
        color: #0b1220;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.55);
      }
      .brand-mark img {
        width: clamp(2.75rem, 6vw, 4rem);
        height: clamp(2.75rem, 6vw, 4rem);
        border-radius: 0.85rem;
        flex-shrink: 0;
        box-shadow: 0 8px 24px rgba(11, 18, 32, 0.12);
      }
      .hero h1 {
        font-family: Lexend, system-ui, sans-serif;
        font-weight: 600;
        font-size: clamp(1.35rem, 2.6vw, 1.85rem);
        line-height: 1.2;
        margin: 0 0 0.85rem;
        letter-spacing: -0.025em;
        max-width: 22ch;
      }
      .hero .lede {
        margin: 0;
        font-size: 1.08rem;
        color: #334155;
        max-width: 34rem;
      }
      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.35rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.72rem 1.15rem;
        border-radius: var(--radius);
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, filter 180ms ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn:active { transform: scale(0.98); }
      .btn-primary {
        background: #0f766e;
        color: #f8fafc;
      }
      .btn-primary:hover { background: #0d9488; }
      .btn-ghost {
        border: 1px solid rgba(11, 18, 32, 0.22);
        color: var(--ink);
        background: #ffffff;
      }
      .btn-ghost:hover { border-color: rgba(11, 18, 32, 0.4); }

      .terminal {
        background: var(--panel);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.82rem;
        line-height: 1.55;
        animation: rise 700ms 160ms ease both;
      }
      .terminal-bar {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        padding: 0.7rem 0.85rem;
        border-bottom: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.72rem;
        background: var(--bg1);
      }
      .dot {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: rgba(11, 18, 32, 0.22);
      }
      .terminal pre {
        margin: 0;
        padding: 1rem 1.05rem 1.2rem;
        white-space: pre-wrap;
        color: #1e293b;
      }
      .prompt { color: var(--accent); font-weight: 500; }
      .dim { color: #64748b; }
      .ok { color: #0f766e; font-weight: 500; }

      main.wrap { padding-bottom: 1rem; }
      section {
        padding: var(--space-2xl) 0;
        border-top: 1px solid var(--rule);
      }
      section.reveal {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 380ms ease, transform 380ms ease;
      }
      section.reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      section h2 {
        font-family: Lexend, system-ui, sans-serif;
        font-weight: 600;
        font-size: clamp(1.4rem, 2.4vw, 1.75rem);
        margin: 0 0 0.7rem;
        letter-spacing: -0.025em;
      }
      section > p {
        margin: 0;
        color: var(--muted);
        max-width: 42rem;
      }
      .audience {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 2rem;
        align-items: start;
      }
      .feature-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0;
        border-top: 1px solid var(--rule);
      }
      .feature-list li {
        display: grid;
        grid-template-columns: 8.5rem 1fr;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .feature-list strong {
        font-family: Lexend, system-ui, sans-serif;
        font-weight: 600;
        font-size: 0.98rem;
      }
      .feature-list span { color: var(--muted); font-size: 0.98rem; }

      ol.steps {
        margin: 1.25rem 0 0;
        padding: 0;
        list-style: none;
        counter-reset: step;
        display: grid;
        gap: 0;
        max-width: 44rem;
        border-top: 1px solid var(--rule);
      }
      ol.steps li {
        counter-increment: step;
        display: grid;
        grid-template-columns: 2.25rem 1fr;
        gap: 0.9rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule);
        color: var(--muted);
      }
      ol.steps li::before {
        content: counter(step, decimal-leading-zero);
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--ink);
        padding-top: 0.15rem;
      }
      .section-links {
        margin-top: 1.15rem;
        color: var(--muted);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.25rem;
        font-size: 1rem;
      }
      th, td {
        text-align: left;
        padding: 0.85rem 0.35rem;
        border-bottom: 1px solid var(--rule);
        color: var(--muted);
        vertical-align: top;
      }
      th {
        color: var(--ink);
        font-weight: 600;
        font-family: Lexend, system-ui, sans-serif;
        font-size: 0.92rem;
      }
      td:first-child { color: var(--ink); }
      .status-ok {
        color: var(--accent);
        font-weight: 600;
      }
      .define {
        max-width: 40rem;
      }
      .define p {
        font-size: 1.05rem;
        line-height: 1.55;
        color: var(--ink);
        margin: 0.5rem 0 0;
      }
      .faq-list {
        list-style: none;
        padding: 0;
        margin: 1rem 0 0;
        display: grid;
        gap: 1rem;
      }
      .faq-list li {
        border-top: 1px solid var(--rule);
        padding-top: 1rem;
      }
      .faq-list h3 {
        font-family: Lexend, system-ui, sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0 0 0.4rem;
        color: var(--ink);
      }
      .faq-list p {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
        max-width: 42rem;
      }

      .trust-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0;
        margin-top: 1.5rem;
        border-top: 1px solid var(--rule);
      }
      .trust-strip article {
        padding: 1.15rem 1.1rem 1.15rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .trust-strip h3 {
        margin: 0 0 0.35rem;
        font-family: Lexend, system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 600;
      }
      .trust-strip p {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .final {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        background: var(--bg1);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        padding: 1.75rem 1.5rem;
        margin-top: var(--space-xl);
        margin-bottom: var(--space-xl);
        border-top: 1px solid var(--rule);
      }
      .final h2 { margin-bottom: 0.45rem; }
      .final p { max-width: 34rem; margin: 0; color: var(--muted); }

      footer {
        padding: 2rem 0 3rem;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer .row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.5rem;
        justify-content: space-between;
        margin-bottom: 0.85rem;
      }
      footer nav {
        gap: 0.85rem;
        flex-wrap: wrap;
      }
      footer nav a { min-height: auto; }

      @keyframes rise {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
          min-height: auto;
          padding-top: 1.5rem;
          align-items: start;
        }
        .hero-plane {
          min-height: auto;
          background:
            linear-gradient(180deg, rgba(238, 242, 246, 0.94) 0%, rgba(238, 242, 246, 0.88) 55%, rgba(226, 232, 240, 0.75) 100%),
            #dce4ea url("/media/hero-atmosphere.png") center top / cover no-repeat;
        }
        .audience { grid-template-columns: 1fr; }
        .feature-list li { grid-template-columns: 1fr; gap: 0.25rem; }
        .trust-strip { grid-template-columns: 1fr 1fr; }
        nav .nav-hide-sm { display: none; }
        .btn { width: 100%; }
        .cta { width: 100%; }
      }
      @media (max-width: 560px) {
        .trust-strip { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .btn { transition: none; }
        .hero-copy,
        .terminal {
          animation: none;
        }
        section.reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="hero-plane">
      <div class="wrap">
        <header>
          <a class="brand-nav" href="/">
            <img src="/media/logo.png" width="32" height="32" alt="" />
            MageLift
          </a>
          <nav aria-label="Primary">
            <a class="nav-hide-sm" href={docsUrl}>Docs</a>
            <a class="nav-hide-sm" href={`${docsUrl}compare-paas/`}>vs PaaS</a>
            <a class="nav-hide-sm" href={`${docsUrl}faq/`}>FAQ</a>
            <a class="nav-hide-sm" href={githubUrl}>GitHub</a>
            <a class="nav-cta" href={`${docsUrl}install/`}>Install the CLI</a>
          </nav>
        </header>

        <div class="hero">
          <div class="hero-copy">
            <p class="brand-mark">
              <img src="/media/logo.png" width="64" height="64" alt="" />
              <span>MageLift</span>
            </p>
            <h1>Run Magento in your own AWS or GCP account.</h1>
            <p class="lede">
              Open-source CLI and ACC/Upsun-shaped YAML. You own the cloud account
              and pay that bill directly.
            </p>
            <div class="cta">
              <a class="btn btn-primary" href={`${docsUrl}install/`}>Install the CLI</a>
              <a class="btn btn-ghost" href={`${docsUrl}getting-started/`}>Get started</a>
            </div>
          </div>

          <div class="terminal" aria-label="Example MageLift commands">
            <div class="terminal-bar">
              <span class="dot" aria-hidden="true"></span>
              <span class="dot" aria-hidden="true"></span>
              <span class="dot" aria-hidden="true"></span>
              <span>preview · eu-north-1</span>
            </div>
            <pre><span class="prompt">$</span> magelift config validate --env preview
<span class="ok">ok</span> <span class="dim">magelift.yaml · compatibility checks passed</span>

<span class="prompt">$</span> magelift preview --env preview
<span class="dim">plan</span> ecs-fargate · digest promote · no mutate

<span class="prompt">$</span> magelift deploy --env preview --yes
