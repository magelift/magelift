---
const docsUrl = '/docs/';
const githubUrl = 'https://github.com/magelift/magelift';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://magelift.dev/#org',
      name: 'MageLift',
      url: 'https://magelift.dev/',
      logo: 'https://magelift.dev/favicon.svg',
      sameAs: ['https://github.com/magelift/magelift'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://magelift.dev/#website',
      url: 'https://magelift.dev/',
      name: 'MageLift',
      publisher: { '@id': 'https://magelift.dev/#org' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'MageLift',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows',
      url: 'https://magelift.dev/',
      downloadUrl: 'https://github.com/magelift/magelift/releases',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description:
        'Open-source CLI and YAML to run Magento Open Source and Adobe Commerce in your own AWS or GCP account.',
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MageLift - Magento in your cloud</title>
    <meta
      name="description"
      content="Open-source CLI and ACC/Upsun-shaped YAML for Magento in your AWS or GCP account. Certified on ECS Fargate and GKE Autopilot. Not a rented PaaS."
    />
    <link rel="canonical" href="https://magelift.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://magelift.dev/" />
    <meta property="og:title" content="MageLift - Magento in your cloud" />
    <meta
      property="og:description"
      content="Deploy Magento in your own AWS or GCP account with familiar YAML and CLI. Certified on ECS Fargate and GKE Autopilot."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style>
      :root {
        --bg0: #0c1613;
        --bg1: #14241e;
        --ink: #f2f6f3;
        --muted: #a8bdb3;
        --accent: #3dbf8c;
        --accent-ink: #042016;
        --rule: rgba(242, 246, 243, 0.12);
        --panel: rgba(8, 18, 14, 0.72);
        --glow: rgba(61, 191, 140, 0.18);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: "Source Sans 3", system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg0);
        min-height: 100vh;
        line-height: 1.5;
      }
      a { color: var(--accent); text-underline-offset: 0.15em; }
      .wrap { width: min(1120px, calc(100% - 2.5rem)); margin: 0 auto; }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.15rem 0;
        position: relative;
        z-index: 2;
      }
      .brand {
        font-family: Fraunces, Georgia, serif;
        font-weight: 700;
        font-size: clamp(1.45rem, 2.4vw, 1.75rem);
        letter-spacing: -0.03em;
        color: var(--ink);
        text-decoration: none;
      }
      nav { display: flex; gap: 1.35rem; font-size: 0.95rem; flex-wrap: wrap; }
      nav a { color: var(--muted); text-decoration: none; }
      nav a:hover { color: var(--ink); }

      .hero-plane {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-bottom: 1px solid var(--rule);
        background:
          radial-gradient(900px 480px at 85% 10%, #1f4a38 0%, transparent 58%),
          linear-gradient(165deg, #0f1c18 0%, var(--bg1) 48%, #0a1410 100%);
      }
      .hero-plane::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(242, 246, 243, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(242, 246, 243, 0.035) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,0.55), transparent 85%);
        pointer-events: none;
        z-index: 0;
      }
      .hero {
        position: relative;
        z-index: 1;
        padding: 4.5rem 0 4rem;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 2.5rem;
        align-items: end;
      }
      .hero-copy { max-width: 36rem; }
      .hero h1 {
        font-family: Fraunces, Georgia, serif;
        font-size: clamp(2.55rem, 5.4vw, 3.85rem);
        line-height: 1.02;
        margin: 0 0 1rem;
        letter-spacing: -0.035em;
      }
      .hero .lede {
        margin: 0;
        font-size: 1.12rem;
        color: var(--muted);
        max-width: 34rem;
      }
      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.15rem;
        border-radius: 0.3rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: var(--accent); color: var(--accent-ink); }
      .btn-ghost {
        border: 1px solid var(--rule);
        color: var(--ink);
        background: transparent;
      }
      .btn-ghost:hover { border-color: rgba(242, 246, 243, 0.28); }

      .terminal {
        background: var(--panel);
        border: 1px solid var(--rule);
        border-radius: 0.55rem;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), 0 0 0 1px var(--glow);
        overflow: hidden;
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.82rem;
        line-height: 1.55;
        opacity: 0;
        transform: translateY(12px);
        animation: rise 700ms 120ms ease forwards;
      }
      .terminal-bar {
        display: flex;
        gap: 0.4rem;
        padding: 0.7rem 0.85rem;
        border-bottom: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.72rem;
      }
      .dot {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: rgba(242, 246, 243, 0.22);
      }
      .terminal pre {
        margin: 0;
        padding: 1rem 1.05rem 1.2rem;
        white-space: pre-wrap;
        color: #d7ebe2;
      }
      .prompt { color: var(--accent); }
      .dim { color: #7f978c; }
      .ok { color: #7ddea8; }

      section {
        padding: 3.25rem 0;
        border-top: 1px solid var(--rule);
      }
      section h2 {
        font-family: Fraunces, Georgia, serif;
        font-size: clamp(1.45rem, 2.5vw, 1.85rem);
        margin: 0 0 0.7rem;
        letter-spacing: -0.02em;
      }
      section p { margin: 0; color: var(--muted); max-width: 42rem; }
      .split {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.75rem 2.5rem;
        margin-top: 1.5rem;
      }
      .item h3 {
        margin: 0 0 0.35rem;
        font-size: 1.05rem;
        font-weight: 700;
      }
      .item p { font-size: 0.98rem; }
      ol.steps {
        margin: 1.15rem 0 0;
        padding: 0;
        list-style: none;
        counter-reset: step;
        display: grid;
        gap: 0.9rem;
        max-width: 42rem;
      }
      ol.steps li {
        counter-increment: step;
        display: grid;
        grid-template-columns: 2rem 1fr;
        gap: 0.85rem;
        color: var(--muted);
      }
      ol.steps li::before {
        content: counter(step);
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        border: 1px solid var(--rule);
        display: grid;
        place-items: center;
        color: var(--ink);
        font-weight: 700;
        font-size: 0.85rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.15rem;
        font-size: 0.98rem;
      }
      th, td {
        text-align: left;
        padding: 0.7rem 0.55rem;
        border-bottom: 1px solid var(--rule);
        color: var(--muted);
        vertical-align: top;
      }
      th { color: var(--ink); font-weight: 600; }
      .final {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
      }
      .final p { max-width: 34rem; }
      footer {
        padding: 2rem 0 3rem;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer .row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.5rem;
        justify-content: space-between;
        margin-bottom: 0.85rem;
      }
      footer nav { gap: 1rem; }
      @keyframes rise {
        to { opacity: 1; transform: translateY(0); }
      }
      @media (max-width: 860px) {
        .hero {
          grid-template-columns: 1fr;
          padding-top: 3rem;
        }
        .split { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .btn { transition: none; }
        .terminal { animation: none; opacity: 1; transform: none; }
      }
    </style>
  </head>
  <body>
    <div class="hero-plane">
      <div class="wrap">
        <header>
          <a class="brand" href="/">MageLift</a>
          <nav>
            <a href={docsUrl}>Docs</a>
            <a href={`${docsUrl}getting-started/`}>Install</a>
            <a href={`${docsUrl}compare-paas/`}>vs PaaS</a>
            <a href={githubUrl}>GitHub</a>
          </nav>
        </header>

        <div class="hero">
          <div class="hero-copy">
            <h1>Magento in your cloud, not a rented PaaS.</h1>
            <p class="lede">
              MageLift is an open-source CLI and ACC/Upsun-shaped config for Magento
              Open Source and Adobe Commerce. You keep the AWS or GCP account.
              Certified on ECS Fargate and GKE Autopilot.
            </p>
            <div class="cta">
              <a class="btn btn-primary" href={`${docsUrl}getting-started/`}>Install the CLI</a>
              <a class="btn btn-ghost" href={docsUrl}>Read the docs</a>
              <a class="btn btn-ghost" href={githubUrl}>View on GitHub</a>
            </div>
          </div>

          <div class="terminal" aria-label="Example MageLift commands">
            <div class="terminal-bar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span>preview · eu-north-1</span>
            </div>
            <pre><span class="prompt">$</span> magelift config validate --env preview
<span class="ok">ok</span> <span class="dim">magelift.yaml · compatibility checks passed</span>

<span class="prompt">$</span> magelift preview --env preview
<span class="dim">plan</span> ecs-fargate · digest promote · no mutate

<span class="prompt">$</span> magelift deploy --env preview --yes
<span class="ok">deployed</span> <span class="dim">https://preview.example.shop</span>

<span class="prompt">$</span> magelift destroy --env preview --yes
<span class="dim">destroyed · spend stopped</span></pre>
          </div>
        </div>
      </div>
    </div>

    <main class="wrap">
      <section>
        <h2>Built for Magento teams who own the account</h2>
        <p>
          Agencies running several shops, and SME owners without a dedicated DevOps
          hire, who want Magento-shaped YAML instead of a blank infrastructure repo.
        </p>
        <div class="split">
          <div class="item">
            <h3>Familiar config</h3>
            <p>
              <code>magelift.yaml</code> follows ACC/Upsun habits so Magento people
              can read the file without learning a new product dialect first.
            </p>
          </div>
          <div class="item">
            <h3>Your invoice</h3>
            <p>
              Compute, data, and edge stay in your cloud. MageLift is the CLI and
              adapters, not a host that resells capacity.
            </p>
          </div>
          <div class="item">
            <h3>Destroyable previews</h3>
            <p>
              Spin a preview, share a URL, tear it down. Production and protected
              destroys stay explicit with <code>--yes</code>.
            </p>
          </div>
          <div class="item">
            <h3>Honest matrix</h3>
            <p>
              Only certified cells are sold as production. Experimental targets stay
              labeled. No fake green.
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2>From install to preview</h2>
        <ol class="steps">
          <li>
            <span>Install a release archive (checksums + SBOM) or build from source.
            Run <code>magelift version</code>.</span>
          </li>
          <li>
            <span>Copy <code>examples/sample-shop/magelift.yaml</code>, fill account
            and secret refs, then <code>magelift config validate</code>.</span>
          </li>
          <li>
            <span>Bootstrap once, then <code>preview</code> / <code>deploy</code> on a
            certified target. Destroy when the spike is done.</span>
          </li>
        </ol>
        <p style="margin-top: 1.25rem;">
          Full path:
          <a href={`${docsUrl}getting-started/`}>Getting started</a>
          ·
          <a href={`${docsUrl}weekend-migrate/`}>Leave PaaS in a weekend</a>
        </p>
      </section>

      <section>
        <h2>Certified targets</h2>
        <p>
          Multi-cloud means the two certified first-party targets below. Everything
          else in the matrix is experimental until it earns a certified cell.
        </p>
        <table>
          <thead>
            <tr>
              <th>Target</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>AWS ECS Fargate</td>
              <td>Certified</td>
            </tr>
            <tr>
              <td>GCP GKE Autopilot</td>
              <td>Certified</td>
            </tr>
            <tr>
              <td>AWS EKS / OVH MKS / Scaleway Kapsule</td>
              <td>Experimental</td>
            </tr>
          </tbody>
        </table>
        <p style="margin-top: 1rem;">
          Details:
          <a href={`${docsUrl}capability-matrix/`}>Capability matrix</a>
          ·
          <a href={`${docsUrl}compare-paas/`}>Compare to ACC / Upsun</a>
        </p>
      </section>

      <section>
        <h2>Trust signals that survive a staff review</h2>
        <div class="split">
          <div class="item">
            <h3>Apache-2.0</h3>
            <p>Source, NOTICE, and license check in CI. No mystery SaaS clause.</p>
          </div>
          <div class="item">
            <h3>Release hygiene</h3>
            <p>GitHub Release archives with checksums and SBOM. Cosign path for images.</p>
          </div>
          <div class="item">
            <h3>Digest promote</h3>
            <p>Build once, promote by digest. Mutable tags are not the happy path.</p>
          </div>
          <div class="item">
            <h3>Independent</h3>
            <p>
              MageLift is independent of Adobe Inc. Magento and Adobe Commerce are
              Adobe trademarks, used only to describe compatibility.
            </p>
          </div>
        </div>
      </section>

      <section class="final">
        <div>
          <h2>Start with the docs, not a sales call</h2>
          <p>
            Install the CLI, validate the sample shop, then decide if a certified
            preview belongs in your account.
          </p>
        </div>
        <div class="cta">
          <a class="btn btn-primary" href={`${docsUrl}getting-started/`}>Install &amp; get started</a>
          <a class="btn btn-ghost" href={githubUrl}>Star the repo</a>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <div class="row">
        <span>© {new Date().getFullYear()} MageLift contributors</span>
        <nav>
          <a href={docsUrl}>Docs</a>
          <a href={githubUrl}>GitHub</a>
          <a href="https://github.com/magelift/magelift/blob/main/SECURITY.md">Security</a>
          <a href="https://github.com/magelift/magelift/blob/main/LICENSE">License</a>
        </nav>
      </div>
      <p>
        MageLift is independent of Adobe Inc. Magento and Adobe Commerce are Adobe
        trademarks, used only to describe compatibility.
      </p>
    </footer>
  </body>
</html>
