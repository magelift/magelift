---
const docsUrl = 'https://docs.magelift.com/';
const githubUrl = 'https://github.com/acourtiol/magelift';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MageLift — Magento on your cloud</title>
    <meta
      name="description"
      content="Deploy Magento in your own AWS or GCP account with ACC/Upsun-shaped YAML and CLI — without renting a PaaS."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg0: #0f1c18;
        --bg1: #163028;
        --ink: #f2f6f3;
        --muted: #b7c7bf;
        --accent: #3dbf8c;
        --accent-ink: #042016;
        --rule: rgba(242, 246, 243, 0.12);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Source Sans 3", system-ui, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(1200px 600px at 80% -10%, #245a45 0%, transparent 55%),
          linear-gradient(165deg, var(--bg0), var(--bg1) 55%, #0c1613);
        min-height: 100vh;
      }
      a { color: var(--accent); text-underline-offset: 0.15em; }
      .wrap { width: min(1080px, calc(100% - 2.5rem)); margin: 0 auto; }
      header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1.25rem 0; border-bottom: 1px solid var(--rule);
      }
      .brand {
        font-family: Fraunces, Georgia, serif;
        font-weight: 700; font-size: 1.35rem; letter-spacing: -0.02em;
        color: var(--ink); text-decoration: none;
      }
      nav { display: flex; gap: 1.25rem; font-size: 0.95rem; }
      nav a { color: var(--muted); text-decoration: none; }
      nav a:hover { color: var(--ink); }
      .hero {
        padding: 5.5rem 0 4rem;
        display: grid;
        gap: 1.25rem;
        max-width: 40rem;
      }
      .hero h1 {
        font-family: Fraunces, Georgia, serif;
        font-size: clamp(2.4rem, 5vw, 3.6rem);
        line-height: 1.05;
        margin: 0;
        letter-spacing: -0.03em;
      }
      .hero p {
        margin: 0;
        font-size: 1.15rem;
        color: var(--muted);
        max-width: 34rem;
      }
      .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0.7rem 1.15rem; border-radius: 0.35rem;
        font-weight: 600; text-decoration: none;
        transition: transform 160ms ease, background 160ms ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: var(--accent); color: var(--accent-ink); }
      .btn-ghost {
        border: 1px solid var(--rule); color: var(--ink); background: transparent;
      }
      section {
        padding: 2.75rem 0;
        border-top: 1px solid var(--rule);
      }
      section h2 {
        font-family: Fraunces, Georgia, serif;
        font-size: 1.6rem; margin: 0 0 0.75rem;
      }
      section p { margin: 0; color: var(--muted); max-width: 40rem; }
      ul { margin: 0.85rem 0 0; padding-left: 1.15rem; color: var(--muted); }
      footer {
        padding: 2rem 0 3rem; border-top: 1px solid var(--rule);
        color: var(--muted); font-size: 0.9rem;
      }
      @media (prefers-reduced-motion: reduce) {
        .btn { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="/">MageLift</a>
        <nav>
          <a href={docsUrl}>Docs</a>
          <a href={githubUrl}>GitHub</a>
          <a href={`${docsUrl}compare-paas/`}>vs PaaS</a>
        </nav>
      </header>

      <main>
        <div class="hero">
          <h1>Magento on your cloud — not a rented PaaS.</h1>
          <p>
            ACC/Upsun-shaped YAML and CLI for Magento teams without dedicated
            DevOps. Certified on AWS ECS Fargate and GCP GKE Autopilot.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href={`${docsUrl}getting-started/`}>Install &amp; get started</a>
            <a class="btn btn-ghost" href={githubUrl}>View on GitHub</a>
            <a class="btn btn-ghost" href={`${docsUrl}weekend-migrate/`}>Migrate from ACC/Upsun</a>
          </div>
        </div>

        <section>
          <h2>Who it’s for</h2>
          <p>
            Agencies and SME Magento owners who want production Magento in their
            own AWS or GCP account — familiar config, honest cost, destroy-when-done previews.
          </p>
        </section>

        <section>
          <h2>Certified targets</h2>
          <ul>
            <li>AWS ECS Fargate — certified</li>
            <li>GCP GKE Autopilot — certified</li>
            <li>EKS / OVH / Scaleway — experimental (not sold as prod)</li>
          </ul>
        </section>

        <section>
          <h2>Trust</h2>
          <p>
            Apache-2.0, release archives with checksums/SBOM, Cosign image signing,
            capability-matrix honesty rules. No fake “green” cells.
          </p>
        </section>
      </main>

      <footer>
        MageLift is independent of Adobe Inc. Magento and Adobe Commerce are Adobe
        trademarks, used only to describe compatibility.
      </footer>
    </div>
  </body>
</html>
